# ===================================================
# MARACUMANGO — CONFIGURACIÓN DE ENTORNO (PLANTILLA)
# ===================================================
# Copia este archivo a `.env` para desarrollo local.
# Para despliegue en Vercel, agrega estas variables en Vercel Dashboard (Settings -> Environment Variables).
# IMPORTANTE: Nunca subas el archivo `.env` a repositorios públicos ni compartas credenciales reales.

# Entorno y puerto del servidor backend (para desarrollo local)
PORT=3001
NODE_ENV=development

# Cadena de conexión a Neon PostgreSQL
# Formato: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-cool-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave secreta para la firma segura de tokens JWT de sesión (Equipo: Admin y Trabajadores)
JWT_SECRET=maracumango_super_secret_jwt_key_change_in_production_2026

# Origen permitido para CORS (En desarrollo local: http://localhost:5173. En Vercel: déjalo vacío o agrega tu dominio)
CORS_ORIGIN=http://localhost:5173

# ===================================================
# SERVICIO DE ENVÍO DE CORREOS (RECUPERACIÓN DE CONTRASEÑA)
# ===================================================
# OPCIÓN A: Cuenta de Gmail con Contraseña de Aplicación (100% Gratis y Recomendado)
# 1. Ve a tu cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicación.
# 2. Genera una contraseña para "Maracumango" (obtendrás 16 letras, ej: abcd efgh ijkl mnop).
# 3. Pega tu correo y esa contraseña de 16 letras aquí:
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion_de_16_letras

# OPCIÓN B: Servicio SMTP personalizado (Brevo, SendGrid, Mailtrap, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_usuario_smtp
# SMTP_PASS=tu_clave_smtp
# SMTP_FROM="Maracumango Neiva" <notificaciones@tudominio.com>

# OPCIÓN C: Resend API (https://resend.com - 3.000 correos gratis/mes)
# RESEND_API_KEY=re_123456789abcdef
# RESEND_FROM="Maracumango" <onboarding@resend.dev>
